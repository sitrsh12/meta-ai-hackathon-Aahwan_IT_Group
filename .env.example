# ── Server ────────────────────────────────
PORT=3050
NODE_ENV=development

# ── Meta AI (REQUIRED) ────────────────────
META_API_KEY=your_meta_api_key_here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# ── Fallback LLM (optional) ───────────────
GROQ_API_KEY=your_groq_key_here

# ── Legacy Zappertrip bridge (optional) ───
# Needed only for real WhatsApp sends.
# If unset, the app runs in CONSOLE-ONLY MODE
# (orders print to the terminal instead of being sent).
MAIN_APP_URL=http://127.0.0.1:3010
MAIN_APP_SEND_WA_PATH=/api/ai-demo/send-wa

# ── MySQL (optional for voice demo) ───────
# Required only for Distributor Copilot (Text-to-SQL) + booking writes.
# On the live server these point at whatsapp_business.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=zappertrip_local
