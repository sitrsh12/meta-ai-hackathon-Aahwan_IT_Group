# ── Server ────────────────────────────────
PORT=3050
NODE_ENV=development

# ── Meta AI (REQUIRED for the Brain) ──────
META_API_KEY=your_meta_api_key_here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# ── Groq (REQUIRED for the Ears/STT) ──────
# Used for whisper-large-v3 to understand Nepali accents
GROQ_API_KEY=your_groq_api_key_here

# ── Legacy Zappertrip bridge (optional) ───
# Needed only for real WhatsApp sends.
MAIN_APP_URL=http://127.0.0.1:3010
MAIN_APP_SEND_WA_PATH=/api/ai-demo/send-wa

# ── MySQL (optional for voice demo) ───────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=zappertrip_local
